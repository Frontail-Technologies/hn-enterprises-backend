PORT=3005
DATABASE_URL=postgres://user:password@localhost:5432/hn_enterprises
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
NODE_ENV=development

# Uploads: local | cloudinary | s3
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads

# Cloudinary upload driver
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hn-enterprises

# AWS/S3 upload driver
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL=
AWS_S3_FORCE_PATH_STYLE=false

# Upload optimization runs in background after the original upload returns.
UPLOAD_OPTIMIZATION_ENABLED=true
UPLOAD_IMAGE_MAX_WIDTH=1600
UPLOAD_IMAGE_MAX_HEIGHT=1600
UPLOAD_IMAGE_QUALITY=78
UPLOAD_KEEP_ORIGINAL=true
GHOSTSCRIPT_BIN=
UPLOAD_MAX_FILE_SIZE_MB=20
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel

# Initial admin seed
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@hnenterprises.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_MOBILE=
SEED_ADMIN_PASSWORD=ChangeMe@123

# Initial supervisor seed
SEED_SUPERVISOR_NAME=Amit Rathore
SEED_SUPERVISOR_EMAIL=supervisor@hnenterprises.com
SEED_SUPERVISOR_USERNAME=supervisor
SEED_SUPERVISOR_MOBILE=9876543210
SEED_SUPERVISOR_PASSWORD=Supervisor@123

# Email provider: console | resend
EMAIL_PROVIDER=console
EMAIL_FROM="HN Enterprises <no-reply@hnenterprises.com>"
RESEND_API_KEY=
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
